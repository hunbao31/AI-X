PORT=8080
JWT_SECRET=dev-secret-change-me
AI_API_KEY=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/math_platform?schema=public"
# Leave unset for local dev (CORS defaults to wide-open). Required in production.
# Comma-separated list; * wildcards supported for preview deployments, e.g.:
#   FRONTEND_URL=https://myapp.vercel.app,https://*.vercel.app
FRONTEND_URL=

# Neural-Symbolic Knowledge Tracing model API. This runs on a teammate's
# personal machine and is exposed through an ngrok tunnel, so the URL
# ROTATES every time that tunnel restarts — it is never hardcoded anywhere
# in the codebase (see src/knowledge-tracing/knowledge-tracing.service.ts).
#
# On Railway: set KT_MODEL_API_URL under Variables. Whoever runs the model
# service must hand you the fresh ngrok URL after every restart, and you
# (or they) need to update this Railway variable manually each time — there
# is no auto-discovery. Redeploy/restart the backend after changing it.
KT_MODEL_API_URL=
# Timeouts are generous because the model call crosses a personal tunnel,
# not a normal server-to-server hop. Defaults below match what the model
# team asked for; only override if you need something different.
KT_MODEL_API_TIMEOUT_STUDENT_MS=30000
KT_MODEL_API_TIMEOUT_CLASS_MS=60000
